# UserEngine Configuration
# Copy this file to .env and modify as needed.
# Environment variables take precedence over .env file values.
#
# Environment-specific files are loaded in order:
#   .env              (base config)
#   .env.local        (local overrides, gitignored)
#   .env.{ENVIRONMENT} (e.g., .env.production)
#   .env.{ENVIRONMENT}.local (local env-specific overrides, gitignored)

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development, staging, production
# In production mode, security checks are enforced (JWT secret, CORS, etc.)
ENVIRONMENT=development

# =============================================================================
# REDIS CONNECTION
# =============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Cluster (optional)
# Set to true to enable cluster mode
REDIS_CLUSTER_ENABLED=false
# Comma-separated list of cluster node addresses
# REDIS_CLUSTER_ADDRS=node1:6379,node2:6379,node3:6379

# =============================================================================
# SERVICE ADDRESSES
# =============================================================================
GATEWAY_ADDR=:8080
API_ADDR=:8081

# =============================================================================
# AUTHENTICATION
# =============================================================================
# IMPORTANT: Change this in production!
# In production mode, "dev-secret-*" values are rejected.
JWT_SECRET=dev-secret-change-in-production

# =============================================================================
# SESSION SETTINGS
# =============================================================================
# Session TTL should be at least 2x HEARTBEAT_INTERVAL
SESSION_TTL=45s

# =============================================================================
# HEARTBEAT SETTINGS
# =============================================================================
HEARTBEAT_INTERVAL=15s
HEARTBEAT_RATE_LIMIT=5s
HEARTBEAT_JITTER_MAX=3s
RECONNECT_GRACE_PERIOD=5s

# =============================================================================
# DEBOUNCE SETTINGS
# =============================================================================
# Delay before executing disconnect (prevents flicker on brief disconnections)
DISCONNECT_DEBOUNCE_DELAY=5s
DEBOUNCER_POLL_INTERVAL=1s
DEBOUNCE_JOB_TTL=60s

# =============================================================================
# FLAPPING PROTECTION (HYSTERESIS)
# =============================================================================
# Window to track transitions
FLAPPING_WINDOW=30s
# Max transitions in window before suppressing events
FLAPPING_THRESHOLD=5
# Sustained offline duration before broadcasting offline event
OFFLINE_DELAY=15s

# =============================================================================
# SWEEPER SETTINGS
# =============================================================================
SWEEPER_INTERVAL=30s
SWEEPER_BUDGET_PER_SCOPE=100ms

# =============================================================================
# GATEWAY SETTINGS
# =============================================================================
MAX_PENDING_EVENTS=100
WRITE_TIMEOUT=10s
PONG_WAIT=60s
# PING_PERIOD must be less than PONG_WAIT
PING_PERIOD=54s
MAX_MESSAGE_SIZE=4096
MAX_CONNS_PER_USER=10
SLOW_CONSUMER_BUFFER=100

# =============================================================================
# CORS SETTINGS
# =============================================================================
# In production, you must set CORS_ALLOWED_ORIGINS
# Comma-separated list of allowed origins
# Supports wildcards: *.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://*.example.com

# Allow all origins (INSECURE - only for development)
# In production mode with CORS_ALLOW_ALL=true, a warning is logged
CORS_ALLOW_ALL=true

# =============================================================================
# WEBHOOK SETTINGS
# =============================================================================
# Enable webhook notifications for presence events
WEBHOOK_ENABLED=false
WEBHOOK_STREAM_NAME=presence:webhooks
WEBHOOK_CONSUMER_GROUP=webhook-workers
WEBHOOK_BATCH_SIZE=10
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5s
WEBHOOK_TIMEOUT=10s
# Required in production when webhooks are enabled
# Used for HMAC-SHA256 signatures (X-Webhook-Signature header)
# WEBHOOK_SECRET=your-webhook-secret-here